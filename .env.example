# Argon2 hash of the passphrase:
#   uv run python -c "import getpass; from argon2 import PasswordHasher; print(PasswordHasher().hash(getpass.getpass()))"
PASSPHRASE_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# openssl rand -hex 32
SESSION_SECRET=
# Optional: enables /mcp for Claude and other MCP clients (32+ chars): openssl rand -hex 32
API_TOKEN=
# Optional: enables natural-language capture (text and voice)
GEMINI_API_KEY=
