# Argon2 hash of the passphrase:
#   uv run python -c "import getpass; from argon2 import PasswordHasher; print(PasswordHasher().hash(getpass.getpass()))"
PASSPHRASE_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# openssl rand -hex 32
SESSION_SECRET=
# Optional: enables /mcp for Claude and other MCP clients (32+ chars): openssl rand -hex 32
API_TOKEN=
# Optional: enables natural-language capture (text and voice)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: web push. uv run python -m today.notify keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=https://today.example
# Optional: job collection at 07:00, 13:00 and 19:00 (feature 07). uv run python -m today.jobs collect --dry-run
JOBS_ENABLED=false
# JOBS_SOURCES=gupy,remotar,linkedin
# Optional: score new jobs against your profile after each slot (feature 08, ADR 0007).
# claude_cli uses your Claude subscription: `claude setup-token` and paste the token below.
# ANALYST=claude_cli
# CLAUDE_CODE_OAUTH_TOKEN=
# ANALYST=anthropic_api
# ANTHROPIC_API_KEY=
# ANALYST_MODEL=sonnet        # Claude Code alias; with anthropic_api it maps to claude-sonnet-5-5
# JOBS_PUSH_SCORE=75
# ANALYZE_LIMIT=20
